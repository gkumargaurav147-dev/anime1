# ---------- Server (apps/server) ----------
# Copy to apps/server/.env (the server loads .env from its own folder).
NODE_ENV=development
HOST=0.0.0.0
PORT=3000

DATABASE_URL=postgres://anime:anime@localhost:5432/anime
# Used by the Jest suite. Created automatically by docker-compose on first start.
TEST_DATABASE_URL=postgres://anime:anime@localhost:5432/anime_test

# Optional. When set, rate-limit counters live in Redis (shared across instances).
# When unset, an in-memory store is used.
REDIS_URL=redis://localhost:6379

# Use a long random string in any real environment (e.g. `openssl rand -base64 48`).
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Age gate: how long a device stays blocked after an under-13 answer.
AGE_GATE_COOLDOWN_HOURS=24

# Rate limit on auth routes (per IP, per route).
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# SMS provider for phone OTP. Only "dev" exists today: codes are logged to the server console.
SMS_PROVIDER=dev

# ---------- Mobile (apps/mobile) ----------
# Optional. If unset, the app talks to port 3000 on the machine running Metro.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000
